<#@ template debug="false" hostspecific="false" language="C#" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System.Globalization" #>
<#@ import namespace="System.Text" #>
<#@ output extension=".g.cs" encoding="us-ascii" #>
<#
// Note: We specify ASCII as output encoding above to prevent different UTF-8 BOM behavior with VS and dotnet-t4.
#>

<#
string GetTypeParameterName(int index, int count, string prefix)
{
	return count == 1 ? prefix : prefix + index.ToString(CultureInfo.InvariantCulture);
}

string GetActionGenerics(int parameterCount)
{
	if (parameterCount == 0)
	{
		return string.Empty;
	}

	var builder = new StringBuilder("<");
	for (var index = 1; index <= parameterCount; index++)
	{
		if (index > 1)
		{
			builder.Append(", ");
		}

		builder.Append("in ");
		builder.Append(GetTypeParameterName(index, parameterCount, "T"));
	}

	builder.Append('>');
	return builder.ToString();
}

string GetFuncGenerics(int parameterCount)
{
	var builder = new StringBuilder("<");
	for (var index = 1; index <= parameterCount; index++)
	{
		if (index > 1)
		{
			builder.Append(", ");
		}

		builder.Append("in ");
		builder.Append(GetTypeParameterName(index, parameterCount, "T"));
	}

	if (parameterCount > 0)
	{
		builder.Append(", ");
	}

	builder.Append("out TResult>");
	return builder.ToString();
}

string GetActionParameters(int parameterCount)
{
	var builder = new StringBuilder("Caller caller");
	for (var index = 1; index <= parameterCount; index++)
	{
		builder.Append(", ");
		builder.Append(GetTypeParameterName(index, parameterCount, "T"));
		builder.Append(' ');
		builder.Append(parameterCount == 1 ? "arg" : "arg" + index.ToString(CultureInfo.InvariantCulture));
	}

	return builder.ToString();
}
#>


/// </summary>
public delegate void CallerAction<#= GetActionGenerics(parameterCount) #>(<#= GetActionParameters(parameterCount) #>);

<# } #>
<# for (var parameterCount = 0; parameterCount <= 12; parameterCount++) { #>
/// <summary>
/// Func accepting a caller<#= parameterCount == 0 ? string.Empty : " and " + parameterCount.ToString(CultureInfo.InvariantCulture) + " parameter" + (parameterCount == 1 ? string.Empty : "s") #>
